      "expected_allowed": false,
      "expected_error_code": "invalid_arguments",
      "expected_security_event": "",
      "expected_workspace_changed": false,
      "expected_affected_paths": [],
      "notes": "read_file without path should fail schema and argument validation."
    },
    {
      "case_id": "wrong_arg_type",
      "category": "invalid_args",
      "tool_name": "read_file",
      "arguments": {
        "path": [
          "README.md"
        ]
      },
      "approval_mode": "readonly",
      "expected_allowed": false,
      "expected_error_code": "invalid_arguments",
      "expected_security_event": "",
      "expected_workspace_changed": false,
      "expected_affected_paths": [],
      "notes": "A list value for path should fail argument validation."
    },
    {
      "case_id": "risky_write_audit_diff",
      "category": "audit_diff",
      "tool_name": "write_file",
      "arguments": {
        "path": "created.txt",
        "content": "created by the tool governance benchmark\n"
      },
      "approval_mode": "auto",
      "expected_allowed": true,
      "expected_error_code": "",
      "expected_security_event": "",
      "expected_workspace_changed": true,
      "expected_affected_paths": [
        "created.txt"
      ],
      "notes": "Allowed write_file should record workspace_changed and the created path."
    },
    {
      "case_id": "risky_patch_audit_diff",
      "category": "audit_diff",
      "tool_name": "patch_file",
      "arguments": {
        "path": "patch_target.txt",
        "old_text": "before",
        "new_text": "after"
      },
      "approval_mode": "auto",
      "expected_allowed": true,
      "expected_error_code": "",
      "expected_security_event": "",
      "expected_workspace_changed": true,
      "expected_affected_paths": [
        "patch_target.txt"
      ],
      "notes": "Allowed patch_file should report a modified fixture path."
    },
    {
      "case_id": "shell_no_workspace_change",
      "category": "audit_diff",
      "tool_name": "run_shell",
      "arguments": {
        "command": "echo hello",
        "timeout": 5
      },
      "approval_mode": "auto",
      "expected_allowed": true,
      "expected_error_code": "",
      "expected_security_event": "",
      "expected_workspace_changed": false,
      "expected_affected_paths": [],
      "notes": "A safe echo command should execute without producing a workspace diff."
    }
  ]
}
