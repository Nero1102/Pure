    {
      "case_id": "context_reduction_checkpoint",
      "category": "context_reduction",
      "setup_actions": [
        {
          "action": "create_checkpoint"
        }
      ],
      "mutation_actions": [
        {
          "action": "append_long_history",
          "entries": 14,
          "chars_per_entry": 320
        }
      ],
      "runtime_config": {
        "mock_outputs": [
          "<final>Context reduction checkpoint was created.</final>"
        ],
        "context_config": {
          "total_budget": 900,
          "section_budgets": {
            "prefix": 1200,
            "memory": 400,
            "knowledge_context": 300,
            "relevant_memory": 300,
            "history": 2600
          },
          "section_floors": {
            "prefix": 80,
            "memory": 60,
            "knowledge_context": 60,
            "relevant_memory": 60,
            "history": 80
          }
        }
      },
      "expected_resume_status": "full-valid",
      "expected_checkpoint_trigger": "context_reduction",
      "expected_trace_events": [
        "checkpoint_created"
      ],
      "expected_allowed_to_continue": true,
      "notes": "A long offline history with tight context budgets should trigger a context_reduction checkpoint."
    },
    {
      "case_id": "workspace_mismatch_checkpoint_created",
