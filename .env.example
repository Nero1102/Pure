# Copy this file to .env and fill only the providers you use.

# Metadata database. SQLite is enough for local development.
PURE_DATABASE_URL=sqlite:///.pure/pure.db

# OpenAI-compatible Responses API.
PURE_OPENAI_API_BASE=https://your-api.example/v1
PURE_OPENAI_API_KEY=
PURE_OPENAI_MODEL=gpt-5.4

# Anthropic-compatible Messages API.
PURE_ANTHROPIC_API_BASE=https://api.anthropic.com/v1
PURE_ANTHROPIC_API_KEY=
PURE_ANTHROPIC_MODEL=claude-sonnet-4-6

# DeepSeek Anthropic-compatible API.
PURE_DEEPSEEK_API_BASE=https://api.deepseek.com/anthropic
PURE_DEEPSEEK_API_KEY=
PURE_DEEPSEEK_MODEL=deepseek-v4-pro

# Knowledge retrieval defaults to fake/mock embeddings and an in-memory JSON store,
# which is what tests and dry runs use.
PURE_VECTOR_STORE=inmemory
PURE_EMBEDDING_PROVIDER=fake
PURE_EMBEDDING_MODEL=text-embedding-3-small
PURE_EMBEDDING_API_KEY=
PURE_EMBEDDING_BASE_URL=https://api.openai.com/v1
